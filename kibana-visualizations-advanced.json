            {
              "id": "3",
              "enabled": true,
              "type": "count",
              "schema": "metric"
            }
          ]
        },
        "uiStateJSON": "{}",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": {
            "index": "hids-events*",
            "filter": [
              {
                "range": {
                  "timestamp": {
                    "gte": "now-24h",
                    "lte": "now"
                  }
                }
              },
              {
                "term": {
                  "severity": "HIGH"
                }
              }
            ],
            "query": {
              "match_all": {}
            }
          }
        }
