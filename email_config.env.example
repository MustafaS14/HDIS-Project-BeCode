#!/usr/bin/env bash
###############################################################################
# HIDS Email Sender Configuration
# Load this file or set these variables before running HIDS email alerts
###############################################################################

# Recipient Email Address
export EMAIL_TO="mustafasyed82@gmail.com"

# SMTP Sender Credentials (Update SMTP_USER and SMTP_PASS with your sender details)
# For Gmail, SMTP_USER is your full Gmail address and SMTP_PASS is an App Password:
# Google Account -> Security -> 2-Step Verification -> App Passwords
export SMTP_SERVER="smtp.gmail.com:587"
export SMTP_USER="${SMTP_USER:-mustafasyed82@gmail.com}"
export SMTP_PASS="${SMTP_PASS:-your-gmail-app-password}"

# Optional: Only send email when HIGH or MEDIUM alerts are detected (set to true/false)
export EMAIL_ONLY_ON_ALERTS="false"
