#!/usr/bin/env bash
###############################################################################
# HIDS Email Sender Configuration
# Load this file or set these variables before running HIDS email alerts
###############################################################################

# Recipient Email Address
export EMAIL_TO="mustafasyed82@gmail.com"

# SMTP Sender Credentials (Update SMTP_USER and SMTP_PASS with your sender details)
# For Gmail, SMTP_USER is your full Gmail address and SMTP_PASS is an App Password:
# Google Account -> Security -> 2-Step Verification -> App Passwords
# Remove the spaces from Google's 16-character app password before saving it here.
export SMTP_SERVER="smtp.gmail.com:587"
export SMTP_USER="${SMTP_USER:-mustafasyed82@gmail.com}"
export SMTP_PASS="${SMTP_PASS:-abcdefghijklmnop}"

# Optional: regular scheduled reports can skip email unless HIGH or MEDIUM alerts are detected.
# One-minute scans always use the stricter new-alert-ID thresholds in send_email_report.sh:
# at least 1 new HIGH alert or at least 5 new MEDIUM alerts.
export EMAIL_ONLY_ON_ALERTS="false"

# Optional: Elasticsearch shipping (used by --ship-elk and manual --instant-check runs).
# Leave unset to skip ELK shipping.
export ELASTIC_URL="${ELASTIC_URL:-}"
export ELASTIC_API_KEY="${ELASTIC_API_KEY:-}"
export ELASTIC_INDEX="${ELASTIC_INDEX:-hids-alerts}"
